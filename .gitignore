# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Tooling / analysis artifacts
/coverage/
/release/
/.claude/
repomix-output.xml

# Contains live production secrets (DB credentials, JWT secret) — never commit
/infor

# Backend has its own separate repo (kareeeeeeem/vips-backend) — don't duplicate here
/lib/vips-backend/
/vips-backend/
node_modules/
.env

# Firebase client config — contains live API keys, keep out of this repo
/android/app/google-services.json
/android/app/src/*/google-services.json
/ios/Runner/GoogleService-Info.plist
/ios/Runner/GoogleService-Info-consumer.plist
/ios/Runner/GoogleService-Info-merchant.plist
/macos/Runner/GoogleService-Info.plist
/lib/firebase_options.dart

# Android release signing — never commit
/android/key.properties
/android/app/upload-keystore.jks
.aider*

# Reviewed-screen captures kept beside the code so they cannot be moved or
# deleted mid-review. Not part of the build.
_screens/

# The QRPayPro admin product (Laravel/MySQL), kept locally as the source of the
# console's theme — 560 MB of vendor code and two licensed archives. The parts
# actually used were copied into lib/vips-backend/admin-web/assets and are
# committed there; see that folder's README for what was taken and why.
lib/admin_dashboard/
